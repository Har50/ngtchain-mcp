{
  "mcpServers": {
    "ngtchain": {
      "command": "npx",
      "args": ["-y", "@ngtchain/mcp@1.7.3"],
      "env": {
        "NGT_AGENT_PRIVATE_KEY": "${user_config.agent_private_key}",
        "NGT_MAX_PRICE": "${user_config.max_price}",
        "NGT_SESSION_BUDGET": "${user_config.session_budget}"
      }
    }
  }
}
